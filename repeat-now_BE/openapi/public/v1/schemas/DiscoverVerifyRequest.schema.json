{
  "title": "DiscoverVerifyRequest",
  "description": "Verify email ownership using a one-time code from discover/start.",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email that received the code."
    },
    "code": {
      "type": "string",
      "minLength": 6,
      "maxLength": 8,
      "description": "One-time verification code."
    }
  },
  "required": ["email", "code"],
  "additionalProperties": false
}
