{
  "title": "ConnectorClusterCreate",
  "description": "Create a connector cluster. Server generates id/audit fields.",
  "type": "object",
  "properties": {
    "name": { "type": "string", "description": "Human-friendly cluster name." },
    "description": { "type": "string", "nullable": true, "description": "Optional admin notes." },
    "labels": {
      "type": "object",
      "description": "Free-form labels for search/organization (e.g., purpose=ingest).",
      "additionalProperties": { "type": "string" }
    },
    "settings": {
      "$ref": "./ConnectorClusterSettings.schema.json",
      "description": "Optional runtime settings applied to all connectors in the cluster."
    }
  },
  "required": ["name"],
  "additionalProperties": false
}
