{
  "title": "CredentialAssignment",
  "description": "Routing rule that applies one credential to an org/site/device scope with optional match filters.",
  "allOf": [
    {
      "$ref": "./ResourceBase.schema.json"
    },
    {
      "$ref": "./OrgScoped.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Display label (not unique)."
        },
        "description": {
          "type": "string",
          "nullable": true
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether this assignment is active."
        },
        "priority": {
          "type": "integer",
          "default": 100,
          "description": "Lower number wins. Tie-breakers: narrower scope > newer updatedAt."
        },
        "credentialId": {
          "type": "string",
          "format": "uuid",
          "description": "Credential to apply."
        },
        "scope": {
          "description": "Where this assignment applies.",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "org"
                  ]
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "sites"
                  ]
                },
                "siteIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "type",
                "siteIds"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "devices"
                  ]
                },
                "deviceIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "type",
                "deviceIds"
              ],
              "additionalProperties": false
            }
          ]
        },
        "match": {
          "type": "object",
          "description": "Optional match filters to narrow devices.",
          "properties": {
            "hostname": {
              "type": "object",
              "properties": {
                "regex": {
                  "type": "string",
                  "description": "ECMAScript-compatible regex; anchors recommended."
                },
                "prefixAny": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "suffixAny": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "labelsAll": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Device must include all provided label key=value pairs."
            },
            "vendorsAny": {
              "type": "array",
              "items": {
                "$ref": "./Vendor.schema.json"
              }
            },
            "modelsAny": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "enabled",
        "priority",
        "credentialId",
        "scope"
      ]
    }
  ]
}
