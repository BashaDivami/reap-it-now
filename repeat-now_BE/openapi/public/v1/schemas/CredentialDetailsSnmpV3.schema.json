{
  "title": "CredentialDetailsSnmpV3",
  "type": "object",
  "description": "SNMP v3 user-based security model.",
  "properties": {
    "username": {
      "type": "string",
      "description": "SNMPv3 security name."
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 161,
      "description": "SNMP UDP port."
    },
    "engineId": {
      "type": "string",
      "description": "Optional authoritative engine ID (hex string)."
    },
    "contextName": {
      "type": "string",
      "description": "Optional context name."
    },
    "securityLevel": {
      "$ref": "./SnmpV3SecurityLevel.schema.json"
    },
    "authProtocol": {
      "$ref": "./SnmpV3AuthProtocol.schema.json",
      "description": "Required when securityLevel is authNoPriv or authPriv."
    },
    "authPasswordSecretId": {
      "type": "string",
      "format": "uuid",
      "description": "SecretId of type `snmp_auth_password`. Required when authProtocol is set."
    },
    "privProtocol": {
      "$ref": "./SnmpV3PrivProtocol.schema.json",
      "description": "Required when securityLevel is authPriv."
    },
    "privPasswordSecretId": {
      "type": "string",
      "format": "uuid",
      "description": "SecretId of type `snmp_priv_password`. Required when privProtocol is set."
    }
  },
  "required": [
    "username",
    "securityLevel"
  ],
  "additionalProperties": false
}
