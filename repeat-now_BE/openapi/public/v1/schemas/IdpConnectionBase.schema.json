{
  "title": "IdpConnectionBase",
  "description": "Common fields for all IdP connections.",
  "type": "object",
  "allOf": [
    { "$ref": "./ResourceBase.schema.json" },
    { "$ref": "./OrgScoped.schema.json" }
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["oidc", "saml"],
      "description": "Connection flavor."
    },
    "name": {
      "type": "string",
      "maxLength": 200,
      "description": "Human-friendly name shown in the console."
    },
    "status": {
      "type": "string",
      "enum": ["active", "disabled"],
      "description": "Enable/disable this connection."
    },
    "description": {
      "type": "string",
      "nullable": true,
      "maxLength": 1000,
      "description": "Optional admin note/description."
    },
    "startUrl": {
      "type": "string",
      "format": "uri",
      "readOnly": true,
      "description": "SP-initiated start URL for this connection."
    }
  },
  "required": ["type", "name", "status"],
  "additionalProperties": false
}
