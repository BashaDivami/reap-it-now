{
  "title": "CredentialDetailsApiRest",
  "type": "object",
  "description": "REST/HTTP API authentication material.",
  "properties": {
    "auth": {
      "type": "object",
      "description": "Authentication configuration.",
      "properties": {
        "type": { "$ref": "./CredentialApiAuthType.schema.json" },
        "apiKey": {
          "type": "object",
          "properties": {
            "in": { "type": "string", "enum": ["header", "query", "cookie"], "description": "Placement of the API key." },
            "name": { "type": "string", "description": "Header/query/cookie name (e.g., X-API-Key)." },
            "apiKeySecretId": { "type": "string", "format": "uuid", "description": "SecretId of type `api_key`." }
          },
          "required": ["in", "name", "apiKeySecretId"],
          "additionalProperties": false
        },
        "basic": {
          "type": "object",
          "properties": {
            "username": { "type": "string" },
            "passwordSecretId": { "type": "string", "format": "uuid", "description": "SecretId of type `password`." }
          },
          "required": ["username", "passwordSecretId"],
          "additionalProperties": false
        },
        "bearer": {
          "type": "object",
          "properties": {
            "tokenSecretId": { "type": "string", "format": "uuid", "description": "SecretId of type `bearer_token`." }
          },
          "required": ["tokenSecretId"],
          "additionalProperties": false
        },
        "mtls": {
          "type": "object",
          "description": "Client certificate authentication.",
          "oneOf": [
            {
              "title": "PEM Pair",
              "type": "object",
              "properties": {
                "clientCertSecretId": { "type": "string", "format": "uuid", "description": "SecretId of type `tls_client_cert_pem`." },
                "clientKeySecretId": { "type": "string", "format": "uuid", "description": "SecretId of type `tls_client_key_pem`." },
                "caBundleSecretId": { "type": "string", "format": "uuid", "description": "SecretId of type `tls_ca_bundle_pem` (optional)." }
              },
              "required": ["clientCertSecretId", "clientKeySecretId"],
              "additionalProperties": false
            },
            {
              "title": "PKCS#12",
              "type": "object",
              "properties": {
                "pkcs12SecretId": { "type": "string", "format": "uuid", "description": "SecretId of type `certificate_pkcs12`." },
                "pkcs12PassphraseSecretId": { "type": "string", "format": "uuid", "description": "SecretId of type `password` (optional)." }
              },
              "required": ["pkcs12SecretId"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["type"],
      "additionalProperties": false
    }
  },
  "required": ["auth"],
  "additionalProperties": false
}

