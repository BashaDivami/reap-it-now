{
  "title": "RoleResolved",
  "type": "object",
  "description": "Resolved role for responses. Includes immutable slug (for references) and mutable name (for display).",
  "properties": {
    "id":   { "type": "string", "format": "uuid", "description": "Role UUID." },
    "slug": { "$ref": "./Slug.schema.json" },
