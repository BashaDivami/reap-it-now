{
  "title": "ConnectorUpdate",
  "description": "Partial update for a connector. Omitted fields are unchanged.",
  "type": "object",
  "properties": {
    "name": { "type": "string", "description": "New display name." },
    "description": { "type": "string", "nullable": true, "description": "Admin notes." },
    "clusterId": {
      "type": "string",
      "format": "uuid",
      "nullable": true,
      "description": "Change cluster membership. Null to leave the cluster."
    },
    "labels": {
      "type": "object",
      "description": "Replace all labels with the provided set.",
      "additionalProperties": { "type": "string" }
    },
    "upgradeRing": {
      "type": "string",
      "description": "Connector upgrade ring (for staged rollouts)."
    }
  },
  "additionalProperties": false
}
