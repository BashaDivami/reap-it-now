{
  "title": "PasswordVerifyRequest",
  "description": "Verify a password for sign-in. Daily sign-ins SHOULD use {email,password}. For legacy/bootstraps, {emailTx,password} is also accepted.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "password": { "type": "string" }
      },
      "required": ["email", "password"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "emailTx": { "type": "string" },
        "password": { "type": "string" }
      },
      "required": ["emailTx", "password"],
      "additionalProperties": false
    }
  ]
}

