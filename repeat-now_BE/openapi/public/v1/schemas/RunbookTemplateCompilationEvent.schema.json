{
  "title": "RunbookTemplateCompilationEvent",
  "description": "Event payload emitted on the runbook template compilation SSE stream.",
  "type": "object",
  "properties": {
    "seq": { "type": "integer", "format": "int64", "minimum": 1 },
    "compilationId": { "type": "string", "format": "uuid" },
    "status": { "type": "string" },
    "stage": { "type": "string" },
    "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
    "message": { "type": "string" },
    "attemptId": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "result": { "$ref": "./RunbookTemplateCompileResult.schema.json" }
  },
  "required": ["seq", "compilationId"],
  "additionalProperties": false
}
