{
  "title": "CredentialStoreCreate",
  "description": "Create payload for a credential store.",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "type": { "type": "string", "description": "Credential store type (cyberark)" },
        "cyberarkCcpHost": { "type": "string" },
        "cyberarkApiPrefix": { "type": "string" },
        "cyberarkAppId": { "type": "string" },
    "cyberarkSafe": { "type": "string" },
    "cyberarkTlsSkipVerify": { "type": "boolean" },
    "cyberarkTlsCaBundleSecretId": { "type": "string", "format": "uuid" },
    "cyberarkTlsClientCertSecretId": { "type": "string", "format": "uuid" },
    "cyberarkTlsClientKeySecretId": { "type": "string", "format": "uuid" },
    "cyberarkTlsClientKeyPassphraseSecretId": { "type": "string", "format": "uuid" }
  },
  "required": ["name", "type", "cyberarkCcpHost", "cyberarkAppId", "cyberarkSafe"],
  "additionalProperties": false
}
