{
  "title": "PasswordRegisterResponse",
  "description": "Result of setting a password.",
  "type": "object",
  "properties": {
    "registeredAt": { "type": "string", "format": "date-time" },
    "nextStep": {
      "type": "string",
      "enum": ["authenticatePassword", "exchangeLoginTx"],
      "description": "Guidance for the client. 'exchangeLoginTx' only when issueLoginTx=true and loginTx is present."
    },
    "loginTx": { "type": "string", "nullable": true, "description": "Optional login handle for /auth/token (grantType: 'loginTx')." },
    "loginTxExpiresAt": { "type": "string", "format": "date-time", "nullable": true }
  },
  "required": ["registeredAt", "nextStep"],
  "additionalProperties": false
}

