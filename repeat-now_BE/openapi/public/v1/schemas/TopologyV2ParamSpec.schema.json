{
  "title": "TopologyV2ParamSpec",
  "description": "Schema for a view parameter so the UI can render controls without networking logic.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": ["string", "number", "integer", "boolean", "object"],
      "description": "Parameter type."
    },
    "required": { "type": "boolean", "description": "Whether this param is required." },
    "default": { "description": "Default value for this param.", "nullable": true },
    "hint": { "type": "string", "description": "Optional hint/example (e.g., pvst:20)." },
    "ui": { "type": "object", "description": "UI rendering hints (control type, placeholders, etc.).", "additionalProperties": true },
    "options": {
      "type": "object",
      "description": "Optional options source definition (for dynamic enums).",
      "additionalProperties": true
    }
  },
  "required": ["type"],
  "additionalProperties": false
}

