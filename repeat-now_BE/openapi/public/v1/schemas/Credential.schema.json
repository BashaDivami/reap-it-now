{
  "title": "Credential",
  "description": "Access material for devices/APIs. One credential = one kind.",
  "allOf": [
    { "$ref": "./ResourceBase.schema.json" },
    { "$ref": "./OrgScoped.schema.json" },
    {
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Display label (not unique)." },
        "description": { "type": "string", "nullable": true, "description": "Optional admin notes." },
        "labels": {
          "type": "object",
          "description": "Free-form labels for organization/search.",
          "additionalProperties": { "type": "string" }
        },
        "kind": { "$ref": "./CredentialKind.schema.json" },
        "details": {
          "oneOf": [
            { "$ref": "./CredentialDetailsCliSsh.schema.json" },
            { "$ref": "./CredentialDetailsSnmpV2c.schema.json" },
            { "$ref": "./CredentialDetailsSnmpV3.schema.json" },
            { "$ref": "./CredentialDetailsApiRest.schema.json" }
          ],
          "description": "Kind-specific fields."
        }
      },
      "required": ["kind", "details"],
      "additionalProperties": false
    }
  ]
}
