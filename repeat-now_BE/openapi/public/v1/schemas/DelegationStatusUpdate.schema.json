{
  "title": "DelegationStatusUpdate",
  "type": "object",
  "description": "Change delegation status. Requires If-Match.",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["suspended", "active", "revoked"],
      "x-enumDescriptions": [
        "Temporarily disable MSP access.",
        "Re-enable a suspended delegation.",
        "Permanently revoke. Terminal."
      ],
      "description": "Target status. Allowed transitions: active↔suspended; (active|suspended)→revoked."
    },
    "reason": { "type": "string", "description": "Optional human-readable reason for audit trails." }
  },
  "required": ["status"],
  "additionalProperties": false
}

